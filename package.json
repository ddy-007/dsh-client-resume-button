{
  "name": "client-resume-button",
  "version": "0.1.3",
  "type": "module",
  "description": "Adds a Continue button to the DeepSeek Harness composer: when the previous turn was interrupted (by the user, a crash, or an error), one click asks the model to pick that turn back up.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "resume",
    "continue",
    "interrupted",
    "composer"
  ],
  "author": "ddy-007",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ddy-007/dsh-client-resume-button.git"
  },
  "bugs": {
    "url": "https://github.com/ddy-007/dsh-client-resume-button/issues"
  },
  "homepage": "https://github.com/ddy-007/dsh-client-resume-button#readme",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./typert": {
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "default": "./lib/typert.remote-client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.19 || >=24"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    },
    "engines": {
      "dsh": ">=0.2.0-rc.2 <0.3.0"
    },
    "compatibility": {
      "dsh": ">=0.2.0-rc.2 <0.3.0",
      "profiles": [
        "web",
        "desktop"
      ],
      "dshReleases": {
        "0.2.0-rc.2": "compatible",
        "0.2.1-rc.2": "compatible"
      }
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-client-locale": "*",
    "@deepseek-ai/dsh-client-ui-conversation": "*",
    "@deepseek-ai/dsh-client-ui-primitives": "*",
    "@deepseek-ai/dsh-client-ui-slots": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-session": "*",
    "@deepseek-ai/dsh-session-projection": "*",
    "@deepseek-ai/dsh-typert-protocol": "*",
    "@deepseek-ai/schemastery": "*",
    "react": "*",
    "zod": "*"
  }
}
